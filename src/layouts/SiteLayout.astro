---
import '@fontsource-variable/ibm-plex-sans/wght.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import { copy, languageNames, languages, homePath, experiencePath, projectsPath, projectPath, type Language, type ProjectId } from '../data/site';

interface Props { lang: Language; title: string; description: string; section?: 'home' | 'experience' | 'projects'; project?: ProjectId }
const { lang, title, description, section, project } = Astro.props;
const t = copy[lang];
const route = (l: Language) => project ? projectPath(l, project) : section === 'experience' ? experiencePath(l) : section === 'projects' ? projectsPath(l) : homePath(l);
const canonical = new URL(route(lang), Astro.site).toString();
const assistive = {
  en: { skip: 'Skip to content', main: 'Main navigation' },
  it: { skip: 'Vai al contenuto', main: 'Navigazione principale' },
  fr: { skip: 'Aller au contenu', main: 'Navigation principale' },
  de: { skip: 'Zum Inhalt springen', main: 'Hauptnavigation' },
  es: { skip: 'Saltar al contenido', main: 'Navegación principal' },
  pl: { skip: 'Przejdź do treści', main: 'Nawigacja główna' },
}[lang];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#edf3f7" />
    <title>{title} — Francesco Finucci</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {languages.map(l => <link rel="alternate" hreflang={l} href={new URL(route(l), Astro.site).toString()} />)}
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site).toString()} />
  </head>
  <body>
    <a class="skip-link" href="#main">{assistive.skip}</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href={homePath(lang)} aria-label={`Francesco Finucci — ${t.nav.home}`}><span class="wordmark-mark" aria-hidden="true"><span></span><span></span><span></span></span><span>Francesco Finucci</span></a>
        <nav class="main-nav" aria-label={assistive.main}>
          <a href={homePath(lang)} aria-current={section === 'home' ? 'page' : undefined}>{t.nav.home}</a>
          <a href={experiencePath(lang)} aria-current={section === 'experience' ? 'page' : undefined}>{t.nav.experience}</a>
          <a href={projectsPath(lang)} aria-current={section === 'projects' ? 'page' : undefined}>{t.nav.projects}</a>
          <a href="#contact">{t.nav.contact}</a>
        </nav>
        <details class="language-menu">
          <summary aria-label={t.nav.language}><span class="language-current">{lang.toUpperCase()}</span><span class="chevron" aria-hidden="true"></span></summary>
          <div class="language-options">
            {languages.map(l => <a href={route(l)} lang={l} data-language={l} aria-current={l === lang ? 'page' : undefined}>{languageNames[l]}</a>)}
            <a class="all-languages" href="/">{t.footer.choose}</a>
          </div>
        </details>
      </header>
      <main id="main"><slot /></main>
      <footer class="site-footer" id="contact">
        <div class="footer-main">
          <div><h2>{t.contact.title}</h2><p>{t.contact.text}</p></div>
          <a class="footer-email" href="mailto:finucci.francesco98@gmail.com">finucci.francesco98@gmail.com<span class="email-icon" aria-hidden="true">↗</span></a>
        </div>
        <div class="footer-bottom"><span>© {new Date().getFullYear()} Francesco Finucci</span><span>{t.footer.line}</span><a href="/">{t.footer.choose}</a></div>
        <p class="translation-notice">{t.footer.notice}</p>
      </footer>
    </div>
    <script is:inline>
      document.querySelectorAll('[data-language]').forEach(link => link.addEventListener('click', () => {
        try { localStorage.setItem('portfolio-language', link.dataset.language); } catch (_) {}
      }));
    </script>
  </body>
</html>
