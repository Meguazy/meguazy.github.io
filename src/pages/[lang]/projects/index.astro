---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import ProjectRow from '../../../components/ProjectRow.astro';
import { copy, languages, projectIds, type Language } from '../../../data/site';
export function getStaticPaths() { return languages.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Language;
const t = copy[lang];
---
<SiteLayout lang={lang} title={t.projectsPage.title} description={t.projectsPage.intro} section="projects">
  <section class="page-intro section-wrap"><span class="page-index">02 / {t.nav.projects}</span><h1>{t.projectsPage.title}</h1><p>{t.projectsPage.intro}</p></section>
  <section class="section-wrap all-projects"><div class="project-list">{projectIds.map((id, index) => <ProjectRow lang={lang} id={id} index={index} />)}</div></section>
</SiteLayout>
