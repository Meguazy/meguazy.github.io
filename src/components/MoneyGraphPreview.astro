---
import type { Language } from '../data/site';
import { moneyGraphPreview } from '../data/moneyGraphPreview';
import { moneyGraphDetails } from '../data/moneyGraphDetails';
import { graphTopology, movementPortrait, type WorkflowKey } from '../data/moneyGraphTopology';
import MoneyWorkflowGraph from './MoneyWorkflowGraph.astro';
const { lang, label } = Astro.props as { lang: Language; label: string };
const t = {...moneyGraphPreview[lang], ...moneyGraphDetails[lang]};
const id = `mt-graph-preview-${lang}`;
const keys: WorkflowKey[] = ['router','expense','read','review','movement'];
---
<button type="button" class="mt-node mt-model mt-langgraph-trigger" popovertarget={id} aria-controls={id} aria-haspopup="dialog">
  <span>{label}</span><span class="mt-graph-hint">{t.hint}<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 3h4M3 3v4M13 3H9M13 3v4M3 13h4M3 13V9M13 13H9M13 13V9" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></span>
</button>
<div id={id} class="mt-graph-preview" popover="auto" role="dialog" aria-modal="false" aria-labelledby={`${id}-title`} aria-describedby={`${id}-intro`}>
  <header class="mt-graph-header"><h3 id={`${id}-title`}>{t.title}</h3><button type="button" class="mt-graph-close" popovertarget={id} popovertargetaction="hide" aria-label={t.close}>×</button></header>
  <p id={`${id}-intro`} class="mt-graph-intro">{t.introduction}</p>
  <div class="mt-graph-orchestration"><strong>{t.orchestration}</strong><p>{t.router} <span aria-hidden="true">→</span> {t.dispatcher} <span aria-hidden="true">→</span> {t.expense} / {t.read} / {t.review} / {t.movement}</p></div>
  <ul class="mt-graph-legend"><li><span class="mt-graph-swatch mt-graph-model"></span>{t.model}</li><li><span class="mt-graph-swatch mt-graph-rule"></span>{t.deterministic}</li><li><span class="mt-graph-swatch mt-graph-mixed"></span>{t.mixed}</li><li><span class="mt-graph-line"></span>{t.conditional}</li></ul>
  <div class="mt-graph-grid">{keys.map(key => (
    <section class:list={['mt-graph-workflow', {'mt-graph-movement':key==='movement'}]} aria-labelledby={`${id}-${key}-heading`}>
      <h4 id={`${id}-${key}-heading`}>{t[key]}</h4>
      <MoneyWorkflowGraph topology={graphTopology[key]} id={`${id}-${key}`} title={t[key]} description={t[`${key}Description`]} labels={t} className={key==='movement' ? 'mt-graph-landscape' : ''} />
      {key==='movement' && <MoneyWorkflowGraph topology={movementPortrait} id={`${id}-${key}-portrait`} title={t[key]} description={t.movementDescription} labels={t} className="mt-graph-portrait" />}
      {(key==='review' || key==='movement') && <p class="mt-graph-workflow-note">{t[`${key}Note`]}</p>}
    </section>
  ))}</div>
  <p class="mt-graph-conclusion">{t.conclusion}</p>
</div>
<script>
  document.querySelectorAll<HTMLButtonElement>('.mt-langgraph-trigger').forEach(trigger => {
    const panel = document.getElementById(trigger.getAttribute('popovertarget') ?? '');
    if (!panel || !('showPopover' in panel)) return;
    let hoverOpened = false;
    let timer: ReturnType<typeof setTimeout> | undefined;
    const cancelClose = () => { clearTimeout(timer); };
    const isOpen = () => panel.matches(':popover-open');
    const position = () => {
      const rect = trigger.getBoundingClientRect();
      const gap = 12;
      const edge = 16;
      const width = panel.offsetWidth;
      const height = panel.offsetHeight;
      const left = Math.max(edge, Math.min(rect.left, window.innerWidth - width - edge));
      const below = rect.bottom + gap;
      const above = rect.top - height - gap;
      const top = below + height <= window.innerHeight - edge ? below : above >= edge ? above : Math.max(edge, (window.innerHeight - height) / 2);
      panel.style.left = `${left}px`;
      panel.style.top = `${top}px`;
      panel.style.margin = '0';
    };
    const scheduleClose = () => {
      cancelClose();
      timer = setTimeout(() => {
        if (hoverOpened && isOpen() && !panel.contains(document.activeElement)) panel.hidePopover();
      }, 220);
    };
    trigger.addEventListener('pointerenter', event => {
      if (event.pointerType !== 'mouse') return;
      cancelClose();
      if (!isOpen()) { hoverOpened = true; panel.showPopover(); position(); }
    });
    trigger.addEventListener('pointerleave', scheduleClose);
    panel.addEventListener('pointerenter', cancelClose);
    panel.addEventListener('pointerleave', scheduleClose);
    panel.addEventListener('pointerdown', () => { hoverOpened = false; cancelClose(); });
    trigger.addEventListener('click', event => {
      // Clicking an automatically opened preview keeps it open for reading.
      if (hoverOpened && isOpen()) { event.preventDefault(); hoverOpened = false; cancelClose(); }
    });
    panel.addEventListener('focusin', () => { hoverOpened = false; cancelClose(); });
    panel.addEventListener('toggle', event => {
      const open = (event as ToggleEvent).newState === 'open';
      trigger.setAttribute('aria-expanded', String(open));
      if (open) position();
      else { hoverOpened = false; cancelClose(); }
    });
    window.addEventListener('resize', () => { if (isOpen()) position(); });
    document.addEventListener('scroll', event => {
      if (!isOpen() || (event.target instanceof Node && panel.contains(event.target))) return;
      if (hoverOpened) panel.hidePopover();
      else position();
    }, true);
  });
</script>
