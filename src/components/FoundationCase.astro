---
import type { Language } from '../data/site';
import { foundationFlow, foundationProject, foundationRepository } from '../data/foundation';
import { foundationStudy, foundationDocumentSources } from '../data/foundationStudy';
interface Props { lang: Language }
const { lang } = Astro.props;
const t = foundationStudy[lang];
const f = foundationFlow[lang];
const project = foundationProject[lang];
const chapters = ['philosophy', 'documents', 'cycle', 'gates', 'evidence', 'continuity', 'start'];
const source = (path: string) => `${foundationRepository}/blob/main/${path}`;
---
<div class="foundation-case section-wrap">
  <div class="fd-thesis"><h2>{t.thesis}</h2><p>{t.introduction}</p></div>
  <nav class="fd-nav" aria-label={project.title}>{t.nav.map((label, i) => <a href={`#foundation-${chapters[i]}`}>{label}<span aria-hidden="true">↓</span></a>)}</nav>

  <section id="foundation-philosophy" class="fd-chapter" aria-labelledby="fd-philosophy-heading">
    <header class="fd-heading"><h2 id="fd-philosophy-heading">{t.philosophy}</h2><p>{t.philosophyIntro}</p></header>
    <dl class="fd-principles">{t.principles.map(([title, text]) => <div><dt>{title}</dt><dd>{text}</dd></div>)}</dl>
  </section>

  <section id="foundation-documents" class="fd-chapter" aria-labelledby="fd-documents-heading">
    <header class="fd-heading"><h2 id="fd-documents-heading">{t.map}</h2><p>{t.mapIntro}</p></header>
    <figure class="fd-map">
      <div class="fd-brief"><strong>{t.owner}</strong><span>{t.ownerText}</span></div>
      <div class="fd-connector" aria-hidden="true">↓</div>
      <div class="fd-memory"><span class="fd-memory-mark" aria-hidden="true"></span><strong>{t.memory}</strong><code>FounDaTionZy /</code></div>
      <p class="fd-inspect">{t.inspect}</p>
      <div class="fd-document-grid">
        {t.documents.map(([title, question, text], i) => <details class="fd-document"><summary><span class="fd-document-title">{title}</span><span class="fd-question">{question}</span><span class="fd-expand" aria-hidden="true">+</span></summary><div class="fd-document-detail"><p>{text}</p><a href={source(foundationDocumentSources[i])}><code>{foundationDocumentSources[i]}</code><span aria-hidden="true"> ↗</span></a></div></details>)}
      </div>
      <figcaption>{t.mapCaption}</figcaption>
    </figure>
  </section>

  <section id="foundation-cycle" class="fd-chapter" aria-labelledby="fd-cycle-heading">
    <header class="fd-heading"><h2 id="fd-cycle-heading">{f.title}</h2><p>{t.cycleIntro}</p></header>
    <figure class="fd-cycle-figure">
      <ol class="fd-cycle">{f.steps.map((step, i) => <li style={`grid-area:${'abcdef'[i]}`}><span class="fd-step">{String(i + 1).padStart(2, '0')}</span><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol>
      <div class="fd-return"><span aria-hidden="true">↺</span><p>{f.feedback}</p></div>
    </figure>
  </section>

  <section id="foundation-gates" class="fd-chapter" aria-labelledby="fd-gates-heading">
    <header class="fd-heading"><h2 id="fd-gates-heading">{t.gates}</h2><p>{t.gatesIntro}</p></header>
    <figure class="fd-gates">
      <p class="fd-example-label">{t.example}</p>
      <ol class="fd-decision-chain">{t.chain.map(([title, text], i) => <li><code>{['OD', 'EXP', 'ADR'][i]}</code><h3>{title}</h3><p>{text}</p></li>)}</ol>
      <div class="fd-connector" aria-hidden="true">↓</div>
      <div class="fd-gate"><div class="fd-gate-symbol" aria-hidden="true"><span>?</span></div><div><h3>{t.gate}</h3><p>{t.gateText}</p></div></div>
      <figcaption>{t.gateCaption}</figcaption>
    </figure>
  </section>

  <section id="foundation-evidence" class="fd-chapter" aria-labelledby="fd-evidence-heading">
    <header class="fd-heading"><h2 id="fd-evidence-heading">{t.evidence}</h2><p>{t.evidenceIntro}</p></header>
    <figure class="fd-evidence"><p class="fd-example-label">{t.snapshot}</p><dl class="fd-status-grid">{t.states.map(([label, value, text], i) => <div class={`fd-status fd-status-${i}`}><dt>{label}</dt><dd><strong>{value}</strong><p>{text}</p></dd></div>)}</dl><figcaption>{t.evidenceCaption}</figcaption></figure>
  </section>

  <section id="foundation-continuity" class="fd-chapter" aria-labelledby="fd-context-heading">
    <header class="fd-heading"><h2 id="fd-context-heading">{t.context}</h2><p>{t.contextIntro}</p></header>
    <figure class="fd-context"><ol>{t.contextNodes.map(([title, text]) => <li><h3>{title}</h3><p>{text}</p></li>)}</ol><figcaption>{t.contextCaption}</figcaption></figure>
  </section>

  <section id="foundation-start" class="fd-chapter" aria-labelledby="fd-start-heading">
    <header class="fd-heading"><h2 id="fd-start-heading">{t.start}</h2><p>{t.startIntro}</p></header>
    <div class="fd-start-paths">{t.paths.map(([title, text, path]) => <a href={source(path)}><h3>{title}<span aria-hidden="true">↗</span></h3><p>{text}</p><code>{path}</code></a>)}</div>
    <div class="fd-contribution"><section><h3>{t.contribution}</h3><p>{project.role}</p></section><section><h3>{t.boundary}</h3><p>{project.boundary}</p></section></div>
    <div class="fd-source-links"><a href={foundationRepository}>{f.repository}<span aria-hidden="true"> ↗</span></a><a href={source('docs/guides/conventions-and-rationale.md')}>{t.sources}<span aria-hidden="true"> ↗</span></a></div>
  </section>
</div>
<style>
  .foundation-case{padding-top:10px;padding-bottom:60px}
  .fd-thesis{display:grid;grid-template-columns:1fr 1fr;gap:65px;margin-bottom:45px;padding-top:20px}
  .fd-thesis h2{font-size:clamp(30px,3.5vw,49px);letter-spacing:-.05em;line-height:1.12;font-weight:500;margin:0}
  .fd-thesis>p{font-size:19px;line-height:1.75;margin:0;color:var(--muted)}
  .fd-nav{display:flex;flex-wrap:wrap;gap:0 28px;border-block:1px solid var(--line);padding:16px 0;margin-bottom:70px}
  .fd-nav a{display:flex;gap:12px;align-items:center;font-size:14px;line-height:1.5;padding:9px 0;color:var(--blue-dark)}
  .fd-nav a:hover{text-decoration:underline;text-underline-offset:5px}.fd-nav span{color:var(--muted)}
  .fd-chapter{scroll-margin-top:25px;margin-top:80px}.fd-chapter:first-of-type{margin-top:0}
  .fd-heading{border-top:3px solid var(--ink);background:#dce9f0;padding:30px 32px;margin-bottom:35px}
  .fd-heading h2{font-size:clamp(28px,3vw,40px);font-weight:500;letter-spacing:-.04em;line-height:1.18;margin:0}
  .fd-heading p{font-size:17px;line-height:1.7;max-width:86ch;color:#405f72;margin:16px 0 0}
  figure{margin:0}figcaption{font-size:14px;line-height:1.65;color:var(--muted);max-width:95ch;margin-top:26px}
  .fd-principles{display:grid;grid-template-columns:1fr 1fr;gap:32px 60px;margin:0}
  .fd-principles>div{border-top:1px solid var(--line);padding-top:19px}.fd-principles dt{font-size:22px;font-weight:500;letter-spacing:-.025em;line-height:1.3}
  .fd-principles dd{margin:12px 0 0;font-size:17px;line-height:1.75;color:var(--muted)}
  .fd-brief{max-width:570px;margin:auto;text-align:center;padding:23px 20px;background:#e2ece9;border:1px solid #a5bfb8}
  .fd-brief strong{display:block;font-size:19px;font-weight:500}.fd-brief>span{display:block;color:#49685f;font-size:14px;margin-top:10px;line-height:1.5}
  .fd-connector{text-align:center;font-size:30px;color:#537c96;line-height:1.5}
  .fd-memory{border:2px solid var(--blue);background:#dce9f0;text-align:center;max-width:570px;margin:auto;padding:24px 18px}
  .fd-memory strong{font-size:23px;font-weight:500;display:block;letter-spacing:-.025em}.fd-memory code{display:block;font-size:12px;margin-top:12px;color:var(--blue-dark)}
  .fd-memory-mark{display:block;width:17px;height:17px;border:4px solid var(--blue);margin:0 auto 15px}
  .fd-inspect{text-align:center;color:var(--muted);font-size:14px;margin:20px 0 35px;line-height:1.6}
  .fd-document-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:26px 24px;border-top:1px solid #8eaabd;padding-top:26px;align-items:start;position:relative}
  .fd-document-grid::before{content:'';position:absolute;top:-15px;left:50%;height:15px;border-left:1px solid #8eaabd}
  .fd-document{background:#f6f9fb;border:1px solid #b6cbd8;position:relative}
  .fd-document::before{content:'';height:26px;position:absolute;top:-27px;left:50%;border-left:1px solid #8eaabd}
  .fd-document summary{cursor:pointer;list-style:none;padding:22px 39px 22px 22px;min-height:140px;position:relative}.fd-document summary::-webkit-details-marker{display:none}
  .fd-document-title{display:block;font-size:19px;font-weight:500;line-height:1.3;letter-spacing:-.02em}.fd-question{display:block;color:var(--muted);font-size:14px;line-height:1.6;margin-top:10px}
  .fd-expand{position:absolute;top:20px;right:16px;font-size:23px;color:var(--blue)}.fd-document[open] .fd-expand{transform:rotate(45deg)}
  .fd-document[open]{border-color:var(--blue);background:#e5eff7}.fd-document-detail{padding:0 22px 23px}.fd-document-detail p{font-size:15px;line-height:1.7;color:#405f72;margin:0 0 19px}
  .fd-document-detail a{color:var(--blue-dark);font-size:12px;line-height:1.8;text-decoration:underline;text-underline-offset:3px;overflow-wrap:anywhere}
  .fd-cycle{list-style:none;display:grid;grid-template-areas:'a b c' 'f e d';grid-template-columns:repeat(3,minmax(0,1fr));gap:46px 40px;margin:0;padding:0}
  .fd-cycle li{position:relative;border:1px solid #a6bfce;background:#e1ecf3;padding:25px;min-height:164px}
  .fd-step{font-family:'IBM Plex Mono',monospace;color:var(--blue);font-size:12px}
  .fd-cycle h3,.fd-decision-chain h3,.fd-context h3{font-size:21px;font-weight:500;letter-spacing:-.025em;margin:13px 0 9px;line-height:1.3;overflow-wrap:anywhere}
  .fd-cycle p,.fd-decision-chain p,.fd-context li p{font-size:15px;line-height:1.7;color:#456478;margin:0}
  .fd-cycle li:not(:last-child)::after{position:absolute;content:'→';right:-32px;top:50%;transform:translateY(-50%);font-size:26px;color:#537c96}
  .fd-cycle li:nth-child(3)::after{content:'↓';right:50%;top:auto;bottom:-40px;transform:translateX(50%)}
  .fd-cycle li:nth-child(4)::after,.fd-cycle li:nth-child(5)::after{content:'←';right:auto;left:-32px}
  .fd-return{border-bottom:2px solid #799bb1;border-left:2px solid #799bb1;display:flex;align-items:center;gap:18px;padding:18px 24px;margin-top:25px;background:#e8f0f5}
  .fd-return>span{font-size:35px;color:var(--blue)}.fd-return p{font-size:15px;line-height:1.7;margin:0;max-width:90ch}
  .fd-example-label{font-size:12px;letter-spacing:.025em;line-height:1.6;color:var(--muted);margin:0 0 20px}
  .fd-decision-chain{list-style:none;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:38px;margin:0;padding:0}
  .fd-decision-chain li{position:relative;border-top:3px solid #4e7592;background:#e5edf3;padding:22px}
  .fd-decision-chain code{font-size:12px;color:var(--blue-dark)}.fd-decision-chain li:not(:last-child)::after{content:'→';position:absolute;right:-30px;top:45%;font-size:26px;color:#537c96}
  .fd-gate{display:flex;align-items:center;gap:35px;border:1px solid #c3ac74;background:#f0eadb;padding:26px 32px}
  .fd-gate-symbol{flex:0 0 43px;width:43px;height:43px;transform:rotate(45deg);border:2px solid #9b7535;display:grid;place-items:center;margin:8px}
  .fd-gate-symbol span{transform:rotate(-45deg);font-family:'IBM Plex Mono',monospace;font-size:24px;color:#795a24}
  .fd-gate h3{font-size:22px;font-weight:500;margin:0 0 10px}.fd-gate p{font-size:16px;line-height:1.7;margin:0;color:#665739;max-width:88ch}
  .fd-status-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px;margin:0}
  .fd-status{border-top:4px solid var(--status);background:#e7edf1;padding:22px 20px;--status:#4a758f}.fd-status-0{--status:#376e63}.fd-status-1{--status:#9b7535}.fd-status-2{--status:#2759b5}.fd-status-3{--status:#687483}
  .fd-status dt{font-size:13px;line-height:1.5;color:#506b7b;min-height:40px}.fd-status dd{margin:0}.fd-status strong{font-size:22px;letter-spacing:-.035em;font-weight:500;color:var(--status);line-height:1.2;display:block;margin:12px 0 18px;overflow-wrap:anywhere}
  .fd-status p{font-size:15px;line-height:1.7;margin:0;color:#405f72}
  .fd-context ol{list-style:none;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:30px;margin:0;padding:0}
  .fd-context li{border:1px dashed #8eaabd;padding:22px 20px;position:relative}.fd-context h3{margin-top:0}.fd-context li:not(:last-child)::after{content:'→';position:absolute;right:-25px;top:40%;color:#537c96;font-size:24px}
  .fd-start-paths{display:grid;grid-template-columns:1fr 1fr;gap:30px}.fd-start-paths>a{display:block;padding:28px;border:1px solid #a6bfce;background:#e1ecf3}
  .fd-start-paths>a:hover{border-color:var(--blue);background:#dce9f0}.fd-start-paths h3{font-size:24px;font-weight:500;margin:0;display:flex;justify-content:space-between;gap:14px;line-height:1.3}
  .fd-start-paths p{font-size:16px;line-height:1.75;color:#405f72;margin:18px 0}.fd-start-paths code{font-size:12px;color:var(--blue-dark);overflow-wrap:anywhere}
  .fd-contribution{display:grid;grid-template-columns:1fr 1fr;gap:45px;margin-top:45px;border-top:1px solid var(--line);padding-top:30px}.fd-contribution h3{font-size:21px;font-weight:500;margin:0 0 12px}.fd-contribution p{font-size:16px;line-height:1.75;margin:0;color:var(--muted)}
  .fd-source-links{display:flex;flex-wrap:wrap;gap:18px 30px;margin-top:30px}.fd-source-links a{font-size:15px;color:var(--blue-dark);text-decoration:underline;text-underline-offset:5px}
  @media(max-width:1050px){.fd-status-grid,.fd-context ol{grid-template-columns:1fr 1fr}.fd-context li:nth-child(2)::after{display:none}.fd-thesis{gap:35px}.fd-document-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:760px){.foundation-case{padding-top:0;padding-bottom:35px}.fd-thesis{display:block;margin-bottom:30px}.fd-thesis h2{font-size:34px}.fd-thesis>p{font-size:17px;margin-top:20px}.fd-nav{margin-bottom:45px;gap:0 20px}.fd-nav a{font-size:13px}.fd-chapter{margin-top:55px}.fd-heading{padding:23px 20px;margin-bottom:26px}.fd-heading h2{font-size:29px}.fd-heading p{font-size:16px}.fd-principles{grid-template-columns:1fr;gap:25px}.fd-principles dt{font-size:21px}.fd-principles dd{font-size:16px}.fd-document-grid{grid-template-columns:1fr;gap:22px}.fd-document summary{min-height:0;padding:21px 42px 21px 20px}.fd-document-title{font-size:20px}.fd-memory strong{font-size:22px}.fd-brief strong{font-size:18px}.fd-cycle{grid-template-areas:'a' 'b' 'c' 'd' 'e' 'f';grid-template-columns:1fr;gap:32px}.fd-cycle li{padding:22px;min-height:0}.fd-cycle li:not(:last-child)::after,.fd-cycle li:nth-child(3)::after,.fd-cycle li:nth-child(4)::after,.fd-cycle li:nth-child(5)::after{content:'↓';left:50%;right:auto;top:auto;bottom:-29px;transform:translateX(-50%);font-size:23px}.fd-return{padding:15px 18px}.fd-decision-chain{grid-template-columns:1fr;gap:32px}.fd-decision-chain li:not(:last-child)::after{content:'↓';top:auto;right:50%;bottom:-29px;transform:translateX(50%);font-size:23px}.fd-gate{gap:20px;padding:23px 20px}.fd-gate-symbol{flex-basis:28px;width:28px;height:28px;margin:4px}.fd-gate-symbol span{font-size:19px}.fd-gate h3{font-size:21px}.fd-gate p{font-size:15px}.fd-status-grid{gap:15px}.fd-status{padding:18px 15px}.fd-status dt{min-height:0;font-size:12px}.fd-status strong{font-size:22px;margin:13px 0}.fd-status p{font-size:14px}.fd-context ol{grid-template-columns:1fr;gap:30px}.fd-context li:not(:last-child)::after{content:'↓';top:auto;right:50%;bottom:-28px;transform:translateX(50%)}.fd-context li:nth-child(2)::after{display:block}.fd-start-paths,.fd-contribution{grid-template-columns:1fr;gap:24px}.fd-start-paths>a{padding:23px}.fd-contribution{margin-top:30px}.fd-source-links{display:grid;gap:20px}}
  @media(max-width:380px){.fd-status-grid{grid-template-columns:1fr}.fd-gate{display:block}.fd-gate-symbol{margin:6px 8px 24px}}
</style>
